# OpenAI / compatible model endpoint
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Paths are resolved relative to this file.
LABELER_IMAGE_DIR=四方图_1系统最新
LABELER_OUTPUT_ROOT=runs
LABELER_PROMPT_FILE=prompt.md
LABELER_SCHEMA_FILE=schemas/annotation_schema.json

# Runtime
LABELER_WORKERS=1
LABELER_TIMEOUT_SECONDS=300
LABELER_MAX_RETRIES=3
LABELER_MAX_ELAPSED_SECONDS=300
LABELER_INITIAL_BACKOFF_SECONDS=1
LABELER_MAX_BACKOFF_SECONDS=60
LABELER_IMAGE_DETAIL=auto
LABELER_TEMPERATURE=0
LABELER_MAX_OUTPUT_TOKENS=10000
LABELER_VERBOSITY=low
